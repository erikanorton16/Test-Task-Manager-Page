# Shared database connection. SQLite is fine for a single-server deployment
# with a persistent disk (e.g. Fly.io, Railway, Render, a small VPS, Docker
# volume). To use Postgres instead (e.g. on Vercel), change the provider in
# prisma/schema.prisma to "postgresql" and point this at your database.
DATABASE_URL="file:./dev.db"

# Shared passcode both flight attendants use to unlock the app. Anyone who
# knows this passcode gets full read/write access to the shared passenger
# list -- there are no separate personal accounts.
APP_PASSCODE="change-me"

# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET="change-me-too"
